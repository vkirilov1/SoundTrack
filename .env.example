# Copy this file to .env and fill in real values. .env is git-ignored.

POSTGRES_DB=soundtrack
POSTGRES_USER=soundtrack
POSTGRES_PASSWORD=change-me

# Any random 256-bit value. Run the command 'openssl rand -base64 32' in any CLI to receive a random value
JWT_SECRET=change-me-to-a-random-secret

# Optional - only needed for password-reset and contact-form emails to actually send.
# Leave blank to run without email; the app just logs a failure and continues.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
APP_MAIL_SUPPORT_TO=
